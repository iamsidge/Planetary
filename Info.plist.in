<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Planetary</string>
	<key>CFBundleDisplayName</key>
	<string>Planetary</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  iOS 26 made UIScene lifecycle adoption mandatory for apps built against
	  the new SDK: without this manifest UIKit traps at launch inside
	  _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption. Cinder's
	  AppCocoaTouch predates scenes and drives a UIWindow from the app
	  delegate, so no scene delegate class is declared here — the manifest
	  alone is what satisfies the check.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- An iPad app, as the original was. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Without a launch screen the app renders letterboxed at legacy size. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>opengles-3</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- CinderIPod reads the local music library via MPMediaQuery. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Planetary reads your music library to build a solar system from it.</string>
</dict>
</plist>
