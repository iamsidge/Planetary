<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Planetary</string>
	<key>CFBundleDisplayName</key>
	<string>Planetary</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  iOS 26 made UIScene lifecycle adoption mandatory for apps built against
	  the new SDK: without it UIKit traps at launch inside
	  _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption. The
	  manifest alone is NOT enough — a real scene delegate is required.
	  CinderSceneDelegate is our patch to Cinder (branch ios26-scene-adoption);
	  it creates the UIWindow from the connecting UIWindowScene and defers
	  setup() until the scene has supplied the geometry.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Cinder</string>
					<key>UISceneDelegateClassName</key>
					<string>CinderSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- An iPad app, as the original was. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>2</integer>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Without a launch screen the app renders letterboxed at legacy size. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>opengles-3</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Used only by the CinderIPod backend (-DPLANETARY_SPOTIFY=OFF). -->
	<key>NSAppleMusicUsageDescription</key>
	<string>Planetary reads your music library to build a solar system from it.</string>

	<!--
	  Spotify backend configuration. Paste the client id from
	  https://developer.spotify.com/dashboard here; it is intentionally empty
	  in source so no credential is committed. Register the same redirect URI
	  on the Spotify app, exactly as written.

	  With the id blank the app still runs: sign-in fails with an explanatory
	  message and the galaxy is simply empty.
	-->
	<key>SpotifyClientID</key>
	<string></string>
	<key>SpotifyRedirectURI</key>
	<string>planetary://spotify-callback</string>

	<!-- The redirect scheme must be registered or the callback never returns. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.cooperhewitt.planetary.spotify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>planetary</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
